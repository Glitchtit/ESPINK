# ESPINK default sdkconfig — esp32c6 Zigbee end device + e-paper.
# Generated values land in sdkconfig (gitignored); these are the curated defaults.

# --- Partition table (custom: app + NVS + Zigbee storage) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Zigbee (esp-zigbee-lib): end device on the native 802.15.4 radio ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Main task / logging ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS tick at 1 kHz (recommended for the Zigbee stack timing) ---
CONFIG_FREERTOS_HZ=1000

# --- Coredump to flash (ELF) for post-mortem crash analysis ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# --- Interrupt watchdog: relaxed to 2s. The e-paper SPI refresh briefly holds
# off interrupts longer than the 300ms default (transient, not a hang), which
# the aggressive default was hard-resetting on (TG1_WDT) mid-refresh. ---
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000
