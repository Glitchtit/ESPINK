# ESPINK default sdkconfig — esp32c6 Zigbee end device + e-paper.
# Generated values land in sdkconfig (gitignored); these are the curated defaults.

# --- Partition table (custom: app + NVS + Zigbee storage) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Zigbee (esp-zigbee-lib): end device on the native 802.15.4 radio ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Main task / logging ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS tick at 1 kHz (recommended for the Zigbee stack timing) ---
CONFIG_FREERTOS_HZ=1000

# --- Interrupt watchdog: relaxed to 2s for the long e-paper SPI refresh. ---
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000

# --- Larger 802.15.4 RX buffer pool to absorb bursts of attribute writes
# without the radio driver dropping/mishandling frames under load. ---
CONFIG_IEEE802154_RX_BUFFER_SIZE=50

# --- Power management (light-sleep sleepy end device, ESPIR pattern) ---
# All three plus esp_zb_sleep_enable()/esp_pm_configure() in zigbee.c are
# required; any one alone leaves the C6 at full clock and the battery flat.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_SLP_IRAM_OPT=y
