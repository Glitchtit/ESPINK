# ESPINK default sdkconfig — esp32c6 Zigbee end device + e-paper.
# Generated values land in sdkconfig (gitignored); these are the curated defaults.

# --- Partition table (custom: app + NVS + Zigbee storage) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Zigbee (esp-zigbee-lib): end device on the native 802.15.4 radio ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Main task / logging ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS tick at 1 kHz (recommended for the Zigbee stack timing) ---
CONFIG_FREERTOS_HZ=1000
